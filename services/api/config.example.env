BUSINEX_ENVIRONMENT=development
BUSINEX_AUTH_MODE=demo
BUSINEX_DATABASE_URL=postgresql+asyncpg://businex_app:businex_app@postgres:5432/businex
BUSINEX_MIGRATION_DATABASE_URL=postgresql+asyncpg://businex_owner:businex_owner@postgres:5432/businex
BUSINEX_SEED_DATABASE_URL=postgresql+asyncpg://postgres:postgres-dev-only@postgres:5432/businex
BUSINEX_OIDC_ISSUER=http://keycloak:8080/realms/businex
BUSINEX_OIDC_AUDIENCE=businex-api
BUSINEX_OIDC_JWKS_URL=http://keycloak:8080/realms/businex/protocol/openid-connect/certs
BUSINEX_CORS_ORIGINS=["http://localhost:8443","http://127.0.0.1:8443","http://localhost:5173"]
BUSINEX_DEMO_PASSWORD=Demo@2025
BUSINEX_DEMO_JWT_SECRET=businex-demo-dev-only-change-me-please-32b
BUSINEX_REDIS_URL=redis://redis:6379/0
BUSINEX_AI_PROVIDER=mock
# AI gateway: mock (default, clearly labelled) | openai | azure_openai | gemini
# A real provider is used only when its credentials below are set; otherwise the mock is used.
BUSINEX_OPENAI_API_KEY=
BUSINEX_OPENAI_MODEL=gpt-4o-mini
BUSINEX_AZURE_OPENAI_API_KEY=
BUSINEX_AZURE_OPENAI_ENDPOINT=
BUSINEX_AZURE_OPENAI_DEPLOYMENT=
BUSINEX_GEMINI_API_KEY=
BUSINEX_AI_TIMEOUT_SECONDS=30
BUSINEX_AI_MAX_RETRIES=2
